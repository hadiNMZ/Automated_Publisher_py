# Copy this file to .env and fill in your real values. Never commit .env.

# Phrase-generation provider: gemini | lmstudio
PHRASE_PROVIDER=lmstudio

# Google Gemini (only needed if PHRASE_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key

# LM Studio (only needed if PHRASE_PROVIDER=lmstudio — assumes local server)
LMSTUDIO_API_URL=http://127.0.0.1:1234/v1/chat/completions
LMSTUDIO_MODEL=mistral-7b-instruct-v0.2

# ElevenLabs (only needed if a plugin uses TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Kokoro (only needed if a plugin uses TTS_PROVIDER=kokoro — local server)
KOKORO_API_URL=http://localhost:8880/v1/audio/speech

# Telegram — get token from @BotFather, chat_id from getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
APPROVAL_TIMEOUT_SECONDS=3600

# Google Drive / YouTube OAuth — see README for setup
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
YOUTUBE_CATEGORY_ID=27

# Render backend: ffmpeg_local (default) | api_service (template, not implemented)
RENDER_BACKEND=ffmpeg_local
FFMPEG_BINARY=ffmpeg

# Only used if RENDER_BACKEND=api_service later
RENDER_API_URL=
RENDER_API_KEY=
